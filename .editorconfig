# SPDX-License-Identifier: PMPL-1.0-or-later
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,a2ml,yml,yaml,ncl}]
indent_size = 2

[*.{adoc,md}]
trim_trailing_whitespace = false
max_line_length = 76

[justfile]
indent_size = 4

[Makefile]
indent_style = tab
