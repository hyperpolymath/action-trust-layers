[project]
name = "action-trust-layers"
purpose = "Layered, DANE/TLSA-inspired trust model for CI supply-chain (GitHub Actions) pinning: trust-anchor + provenance/key + leaf-exact layers, vs flat recursive SHA-pinning."
status = "design / v0"

[policy]
docs = "AsciiDoc (.adoc) by default; .md only for GitHub community-health files."

